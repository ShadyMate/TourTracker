# Database Configuration
# Copy this file to .env and fill in your values
DB_NAME=tour_tracker
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=jdbc:postgresql://postgres:5432/tour_tracker

# JWT Secret — base64-encoded HMAC-SHA256 key, MUST decode to at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_base64_encoded_secret_here

# Cookie settings
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200

# Trusted reverse proxy IPs for X-Forwarded-For (comma-separated).
# Leave empty for direct deployments with no load balancer.
TRUSTED_PROXY_IPS=

# OpenRouteService API Key — get one free at https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=your_ors_api_key_here
